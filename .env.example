# Environment Configuration for Bilbord RTB Platform

# ==================== NETWORK RPC URLs ====================

# Monad Testnet
MONAD_RPC_URL=https://testnet.monad.com

# Monad Mainnet (when available)
MONAD_MAINNET_RPC=https://mainnet.monad.com

# Ethereum (for reference, alternative chains)
ETH_MAINNET_RPC=https://eth.llamarpc.com
SEPOLIA_RPC=https://rpc.ankr.com/eth_sepolia

# ==================== PRIVATE KEYS ====================

# Owner/Admin private key (for deployment)
ADMIN_PRIVATE_KEY=0x...your_admin_private_key_here

# Test accounts (for local testing)
TEST_PRIVATE_KEY_1=0x...
TEST_PRIVATE_KEY_2=0x...
TEST_PRIVATE_KEY_3=0x...

# ==================== CONTRACT ADDRESSES ====================

# Deployed contract addresses
ADEXCHANGE_ADDRESS=0x...
ORACLE_ADDRESS=0x...
BIDDER_NIKE_ADDRESS=0x...
BIDDER_COCA_ADDRESS=0x...

# Billboard addresses
BILLBOARD_TIMES_SQUARE=0x...
BILLBOARD_SHIBUYA=0x...

# ==================== CONFIGURATION ====================

# Chain ID
CHAIN_ID=10143  # Monad testnet chain ID

# Gas settings
GAS_PRICE=50  # gwei
GAS_LIMIT=1000000

# Platform settings
PLATFORM_FEE_PERCENT=500  # 5% (500 basis points)
AUCTION_DURATION_MS=300  # 300 milliseconds
CROWD_DENSITY_THRESHOLD=50  # 50% minimum

# ==================== ORACLE SETTINGS ====================

# Oracle service endpoint
ORACLE_SERVICE_URL=http://localhost:3000
ORACLE_API_KEY=your_oracle_api_key

# Density reporting parameters
DENSITY_CHECK_INTERVAL=30  # seconds
DENSITY_REPORT_TIMEOUT=10  # seconds

# ==================== MONAD SPECIFIC ====================

# Monad parallelization
ENABLE_PARALLEL_EXECUTION=true
PARALLEL_THREADS=4

# Block time settings
MONAD_BLOCK_TIME=1000  # 1 second in milliseconds

# ==================== TESTING ====================

# Foundry settings
FOUNDRY_PROFILE=default
TEST_GAS_LIMIT=100000000

# Fork settings
FORK_URL=https://testnet.monad.com
FORK_BLOCK_NUMBER=0

# ==================== LOGGING ====================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable detailed logs
VERBOSE_LOGS=false

# ==================== DEPLOYMENT ====================

# Deployment network (mainnet, testnet, local)
DEPLOYMENT_NETWORK=testnet

# Verify contracts on explorer
VERIFY_CONTRACTS=true

# Block explorer API key (for verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
MONAD_EXPLORER_API_KEY=your_monad_explorer_api_key

# ==================== SECURITY ====================

# Access control roles
ADMIN_ROLE=0x0000000000000000000000000000000000000000
ORACLE_ROLE=0x0000000000000000000000000000000000000001

# Multi-sig wallet (for extra security)
MULTISIG_ADDRESS=0x...

# ==================== MONITORING ====================

# Monitoring service
MONITORING_ENDPOINT=http://localhost:3001
MONITORING_API_KEY=your_monitoring_api_key

# Alert settings
ENABLE_ALERTS=true
ALERT_EMAIL=admin@bilbord.dev

# ==================== ADVANCED ====================

# RPC request timeout (ms)
RPC_TIMEOUT=30000

# Transaction confirmation blocks
CONFIRMATION_BLOCKS=12

# Enable optimizations
ENABLE_OPTIMIZATIONS=true

# Batch size for operations
BATCH_SIZE=50

# Retry settings
MAX_RETRIES=3
RETRY_DELAY=1000  # ms
